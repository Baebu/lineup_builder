]

a = Analysis(
    ['main.py'],
    pathex=['.'],
    binaries=dpg_bins,
    datas=dpg_datas + runtime_datas,
    hiddenimports=dpg_hidden + [
        'yaml',
        # package tree
        'src',
        'src.backend',
        'src.backend.api_client',
        'src.backend.data_manager',
        'src.backend.debounce',
        'src.backend.event_bus',
        'src.backend.lineup_model',
