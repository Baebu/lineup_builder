{
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": true,
    "copyToClipboard": false
  },
  "include": [
    "desktop/main.py",
    "desktop/dev.py",
    "desktop/src/__init__.py",
    "desktop/src/backend/**/*.py",
    "desktop/src/frontend/**/*.py",
    "desktop/README.md",
    "desktop/requirements.txt",
    "desktop/pyproject.toml",
    "desktop/desktop_pack_with_root.txt",
    "desktop/desktop_pack.txt",
    "desktop/lineup_builder.spec",
    ".github/copilot-instructions.md"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/__pycache__/**",
      "**/*.pyc",
      "assets/**",
      "repomix-output.*",
      "repomix.config.json"
    ]
  }
}
